SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Backend (optional)
# Comma-separated list of frontend origins allowed to call the API (replaces the built-in defaults)
ALLOWED_ORIGINS=https://adimplan.vercel.app
# When SUPABASE_URL and SUPABASE_ANON_KEY are set on the API server, the e-mail and
# optical-import endpoints require a signed-in user whose membership role is owner
# or coach. Real e-mail is refused unless both are set.
# Parent e-mails stay in dry-run mode while RESEND_API_KEY is empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Adimplan <noreply@adimplan.com>
SENTRY_DSN=
